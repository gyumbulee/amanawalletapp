APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum: domains that receive stateful (cookie-based) auth. Only relevant
# for the Flutter Web build talking to the API from a browser - mobile
# clients authenticate via bearer token regardless of this setting. Add
# your real web domain(s) here in production, comma-separated.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# --- Payment infrastructure -------------------------------------------
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
# From the Flutterwave dashboard's webhook settings - verified against the
# 'verif-hash' header on every incoming webhook. Required, not optional:
# WebhookController::flutterwave() rejects any request that fails this check.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# --- Bill payment providers ---------------------------------------------
# VTPASS_BASE_URL has no safe default: config/services.php falls back to
# VTpass's SANDBOX endpoint if this is left blank, which would silently
# process real customer purchases against test infrastructure. Set this
# explicitly for every environment - sandbox for dev/staging, live for prod.
#   Sandbox: https://sandbox.vtpass.com/api
#   Live:    https://vtpass.com/api
VTPASS_BASE_URL=
VTPASS_API_KEY=
VTPASS_SECRET_KEY=

BIGISUB_BASE_URL=
BIGISUB_API_KEY=

# ePINs: recharge card generation/printing (admin/Filament-only, no Flutter
# client exposure).
EPINS_BASE_URL=
EPINS_API_KEY=
EPINS_CARD_NAME="Amana Wallet"

VITE_APP_NAME="${APP_NAME}"
